# =====================================================
# SaveVia Production Environment Variables
# Copy this to .env and fill in your production values
# NEVER commit .env to git!
# =====================================================

# ==================== AWS RDS MySQL ====================
# Create RDS instance: db.t3.micro, MySQL 8.0, ca-central-1
MYSQL_HOST=savevia-prod-db.xxxxxx.ca-central-1.rds.amazonaws.com
MYSQL_DATABASE=savevia
MYSQL_USER=savevia_admin
MYSQL_PASSWORD=your-strong-db-password

# ==================== AWS ElastiCache Redis ====================
# Create ElastiCache: cache.t3.micro, Redis 7.0
REDIS_HOST=savevia-prod-redis.xxxxxx.0001.cac1.cache.amazonaws.com
REDIS_PORT=6379

# ==================== RabbitMQ (Docker on EC2) ====================
RABBITMQ_USER=savevia
RABBITMQ_PASSWORD=your-rabbitmq-password

# ==================== Eureka Service Discovery ====================
EUREKA_USER=eureka
EUREKA_PASSWORD=your-eureka-password

# ==================== JWT Authentication ====================
# Generate with: openssl rand -base64 64
JWT_SECRET=your-256-bit-jwt-secret-key-must-be-very-long-and-secure

# ==================== Google OAuth ====================
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# ==================== Apple Sign In ====================
APPLE_CLIENT_ID=com.savevia.app

# ==================== Email (SMTP) ====================
# For AWS SES: smtp.email.ca-central-1.amazonaws.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ==================== OpenAI API ====================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=true

# ==================== Python AI service (savevia-ai) ====================
# Gateway upstream for AI routes + base URL for generated share links
SAVEVIA_AI_URL=http://savevia-ai:8002
SHARE_BASE_URL=https://savevia.app

# ==================== Flinks (Open Banking) ====================
FLINKS_API_URL=https://toolbox-api.private.fin.ag/v3
FLINKS_CUSTOMER_ID=your-flinks-customer-id
FLINKS_IFRAME_URL=https://toolbox-iframe.private.fin.ag/
FLINKS_SANDBOX=false

# ==================== Frontend URL ====================
# CloudFront distribution URL
FRONTEND_URL=https://savevia.app

# ==================== AI Usage Limits ====================
AI_MONTHLY_LIMIT=100

# ==================== App Version (Force Update) ====================
APP_VERSION_LATEST=1.0.5
APP_VERSION_MIN=1.0.4

# ==================== APNs Push Notification ====================
# Get from Apple Developer > Keys > Create Key (APNs)
# Key file (.p8) should be placed in ./keys/ directory
APNS_ENABLED=true
APNS_PRODUCTION=true
APNS_KEY_ID=YOUR_KEY_ID
APNS_TEAM_ID=YOUR_TEAM_ID
APNS_KEY_PATH=/app/keys/AuthKey.p8
APNS_BUNDLE_ID=com.savevia.app

# ==================== Admin Dashboard ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password
ADMIN_TOKEN_SECRET=your-admin-token-secret

# ==================== AWS S3 ====================
AWS_S3_AVATAR_BUCKET=savevia-avatars
AWS_REGION=ca-central-1
