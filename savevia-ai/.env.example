# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=savevia
DB_USER=savevia
DB_PASSWORD=savevia123
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT (MUST match Java services — use the same value as savevia-user/.env)
JWT_SECRET=savevia-jwt-secret-key-2024-must-be-at-least-256-bits-long
JWT_ALGORITHM=HS256

# Java service URLs (Docker DNS in dev, internal DNS in prod)
USER_SERVICE_URL=http://localhost:8081
CARD_SERVICE_URL=http://localhost:8082
HTTP_TIMEOUT_SECONDS=10.0
HTTP_CONNECT_TIMEOUT_SECONDS=2.0

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

# Flinks bank-data integration (demo mode unless a real contract is configured)
FLINKS_API_URL=https://toolbox-api.private.fin.ag/v3
FLINKS_CUSTOMER_ID=43387ca6-0391-4c82-857d-70d95f087ecb
FLINKS_IFRAME_URL=https://toolbox-iframe.private.fin.ag/
FLINKS_SANDBOX=true
SAVEVIA_CONNECTION_MAX_PER_MONTH=5

# Service
SERVICE_NAME=savevia-ai
SERVICE_PORT=8002
LOG_LEVEL=INFO
ENVIRONMENT=development
