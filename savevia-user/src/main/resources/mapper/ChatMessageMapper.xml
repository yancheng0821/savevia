<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.savevia.user.mapper.ChatMessageMapper">

    <resultMap id="messageResultMap" type="com.savevia.user.entity.ChatMessage">
        <id property="id" column="id"/>
        <result property="conversationId" column="conversation_id"/>
        <result property="role" column="role"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- Insert a new message -->
    <insert id="insert" parameterType="com.savevia.user.entity.ChatMessage"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_messages (conversation_id, role, content, created_at)
        VALUES (#{conversationId}, #{role}, #{content}, UTC_TIMESTAMP())
    </insert>

    <!-- Get all messages for a conversation -->
    <select id="selectByConversationId" parameterType="java.lang.Long" resultMap="messageResultMap">
        SELECT * FROM chat_messages
        WHERE conversation_id = #{conversationId}
        ORDER BY created_at ASC
    </select>

    <!-- Get recent messages (for context window) -->
    <select id="selectRecentByConversationId" resultMap="messageResultMap">
        SELECT * FROM (
            SELECT * FROM chat_messages
            WHERE conversation_id = #{conversationId}
            ORDER BY created_at DESC
            LIMIT #{limit}
        ) AS recent
        ORDER BY created_at ASC
    </select>

    <!-- Get first message (for title) -->
    <select id="selectFirstByConversationId" parameterType="java.lang.Long" resultMap="messageResultMap">
        SELECT * FROM chat_messages
        WHERE conversation_id = #{conversationId}
        ORDER BY created_at ASC
        LIMIT 1
    </select>

    <!-- Delete by conversation id -->
    <delete id="deleteByConversationId" parameterType="java.lang.Long">
        DELETE FROM chat_messages WHERE conversation_id = #{conversationId}
    </delete>

</mapper>
