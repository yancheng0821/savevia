# =====================================================
# SaveVia Environment Variables
# Copy this to .env and fill in your values
# NEVER commit this file to git!
# =====================================================

# ==================== Database ====================
MYSQL_ROOT_PASSWORD=your-root-password
MYSQL_DATABASE=savevia
MYSQL_USER=savevia
MYSQL_PASSWORD=your-db-password

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== RabbitMQ ====================
RABBITMQ_USER=savevia
RABBITMQ_PASSWORD=your-rabbitmq-password

# ==================== Eureka ====================
EUREKA_USER=eureka
EUREKA_PASSWORD=your-eureka-password

# ==================== JWT ====================
JWT_SECRET=your-jwt-secret-key-must-be-at-least-256-bits-long

# ==================== Mail (SMTP) ====================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ==================== OpenAI ====================
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=true

# ==================== Flinks (Open Banking) ====================
FLINKS_API_URL=https://toolbox-api.private.fin.ag/v3
FLINKS_CUSTOMER_ID=your-flinks-customer-id
FLINKS_IFRAME_URL=https://toolbox-iframe.private.fin.ag/
FLINKS_SANDBOX=true

# ==================== Google OAuth ====================
GOOGLE_CLIENT_ID=your-google-web-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id

# ==================== Apple Sign In ====================
APPLE_CLIENT_ID=com.savevia.app
