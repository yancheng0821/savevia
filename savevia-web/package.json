{
  "name": "savevia-web",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:prod": "tsc && vite build --mode production",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:ios:prod": "npm run build:prod && npx cap sync ios && npx cap open ios",
    "cap:android": "npm run build && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/in-app-review": "^6.0.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/camera": "^7.0.3",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/device": "^8.0.0",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^7.0.3",
    "@capacitor/splash-screen": "^7.0.4",
    "@react-oauth/google": "^0.12.2",
    "@revenuecat/purchases-capacitor": "^11.2.17",
    "@southdevs/capacitor-google-auth": "^7.0.0",
    "@tanstack/react-query": "^5.14.0",
    "antd": "^5.12.5",
    "axios": "^1.6.2",
    "capacitor-secure-storage-plugin": "^0.12.0",
    "dayjs": "^1.11.10",
    "i18next": "^23.7.11",
    "i18next-browser-languagedetector": "^7.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.21.0",
    "recharts": "^2.10.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
